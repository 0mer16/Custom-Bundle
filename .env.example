# Shopify API credentials (replace with your values)
SHOPIFY_API_KEY=your_api_key_here
SHOPIFY_API_SECRET=your_api_secret_here

# Scopes required for the app
SCOPES=read_products,write_products,read_orders,write_orders,read_customers,write_customers

# App URL (replace with your Render URL in production)
HOST=https://your-app-url.onrender.com

# Environment
NODE_ENV=development 