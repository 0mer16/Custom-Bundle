<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Custom Bundles App</title>
  <link rel="stylesheet" href="/admin.css">
</head>
<body data-shop="<%= shop %>">
  <!-- Admin Header -->
  <header class="admin-header">
    <div class="admin-header-content">
      <div class="admin-logo">
        <a href="/admin?shop=<%= shop %>">Custom Bundles App</a>
      </div>
      <nav class="admin-nav">
        <a href="/admin?shop=<%= shop %>" class="admin-nav-item <%= path === '/admin' ? 'active' : '' %>">Dashboard</a>
        <a href="/admin/bundles?shop=<%= shop %>" class="admin-nav-item <%= path === '/admin/bundles' ? 'active' : '' %>">Bundles</a>
      </nav>
      <div class="admin-shop">
        <span class="shop-name"><%= shop %></span>
      </div>
    </div>
  </header>

  <!-- Admin Sidebar and Content -->
  <div class="admin-container">
    <!-- Sidebar -->
    <aside class="admin-sidebar">
      <div class="sidebar-menu">
        <div class="sidebar-menu-title">Bundles</div>
        <a href="/admin/bundles?shop=<%= shop %>" class="sidebar-menu-item <%= path === '/admin/bundles' ? 'active' : '' %>">All Bundles</a>
        <a href="/admin/bundles/create?shop=<%= shop %>" class="sidebar-menu-item <%= path === '/admin/bundles/create' ? 'active' : '' %>">Create Bundle</a>
      </div>
      <div class="sidebar-menu">
        <div class="sidebar-menu-title">Settings</div>
        <a href="/admin/settings?shop=<%= shop %>" class="sidebar-menu-item <%= path === '/admin/settings' ? 'active' : '' %>">App Settings</a>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="admin-content">
      <%- body %>
    </main>
  </div>

  <!-- Notification Container -->
  <div id="notification-container"></div>

  <!-- Admin JavaScript -->
  <script src="/admin.js"></script>
</body>
</html> 