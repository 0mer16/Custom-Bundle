<%- contentFor('body') %>

<div class="page-header">
  <h1 class="page-title">Bundles</h1>
  <div class="page-actions">
    <a href="/admin/bundles/create?shop=<%= shop %>" class="btn btn-primary">Create Bundle</a>
  </div>
</div>

<div class="card">
  <div class="card-content">
    <% if (bundles && bundles.length > 0) { %>
      <table class="table">
        <thead>
          <tr>
            <th style="width: 60px"></th>
            <th>Bundle</th>
            <th>Products</th>
            <th>Discount</th>
            <th>Status</th>
            <th>Created</th>
            <th style="width: 120px">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% bundles.forEach(bundle => { %>
            <tr>
              <td>
                <% if (bundle.image) { %>
                  <img src="<%= bundle.image %>" alt="<%= bundle.title %>" class="table-img">
                <% } else { %>
                  <div class="table-img" style="background-color: #f6f6f7;"></div>
                <% } %>
              </td>
              <td>
                <strong><%= bundle.title %></strong>
                <div style="font-size: 12px; color: #6d7175;">/<%= bundle.handle %></div>
              </td>
              <td><%= bundle.products ? bundle.products.length : 0 %> products</td>
              <td>
                <% if (bundle.discount_type === 'percentage') { %>
                  <%= bundle.discount_value %>%
                <% } else { %>
                  $<%= bundle.discount_value.toFixed(2) %>
                <% } %>
              </td>
              <td>
                <% if (bundle.published) { %>
                  <span class="badge badge-success">Published</span>
                <% } else { %>
                  <span class="badge badge-draft">Draft</span>
                <% } %>
              </td>
              <td><%= new Date(bundle.created_at).toLocaleDateString() %></td>
              <td>
                <a href="/admin/bundles/<%= bundle.id %>/edit?shop=<%= shop %>" class="btn btn-sm btn-secondary">Edit</a>
                <button class="btn btn-sm btn-danger delete-bundle" data-id="<%= bundle.id %>">Delete</button>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } else { %>
      <div style="text-align: center; padding: 48px 0;">
        <h3>No bundles yet</h3>
        <p style="color: #6d7175; margin-bottom: 24px;">Create your first bundle to start selling product collections.</p>
        <a href="/admin/bundles/create?shop=<%= shop %>" class="btn btn-primary">Create Bundle</a>
      </div>
    <% } %>
  </div>
</div>

<script>
  // Handle bundle deletion
  document.addEventListener('DOMContentLoaded', function() {
    const deleteButtons = document.querySelectorAll('.delete-bundle');
    
    deleteButtons.forEach(button => {
      button.addEventListener('click', function() {
        const bundleId = this.dataset.id;
        
        if (confirm('Are you sure you want to delete this bundle? This action cannot be undone.')) {
          // In a real app, this would be an API call
          fetch(`/admin/api/bundles/${bundleId}?shop=<%= shop %>`, {
            method: 'DELETE',
            headers: {
              'Content-Type': 'application/json'
            }
          })
          .then(response => {
            if (response.ok) {
              // Reload the page to reflect the changes
              window.location.reload();
            } else {
              throw new Error('Failed to delete bundle');
            }
          })
          .catch(error => {
            alert('Error: ' + error.message);
          });
        }
      });
    });
  });
</script> 